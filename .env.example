# Local development needs no variables: every one has a validated default
# (see src/config/env.ts, src/config/client.ts). Copy this file to .env and
# override only what you need. Never commit a real .env.
#
# Required outside local development (startup fails fast naming the variable):
#   ISSUER         must be an https URL
#   CLIENT_SECRET  must be set to a real secret, not the placeholder
# Also set these in any real deployment: DATABASE_URL, KEY_RING_PATH on
# persistent storage, CLIENT_REDIRECT_URI and CLIENT_AUDIENCE.

# --- Core server config -----------------------------------------------------

# Base URL used as the `iss` claim and in the discovery document. Required
# outside local development, and must be https. Plain http is accepted only
# for localhost, 127.0.0.1 and [::1].
ISSUER=http://localhost:3000

# HTTP listen port.
PORT=3000

# Access-token lifetime, in seconds.
TOKEN_TTL_SECONDS=300

# Seeds the initial signing key on first boot only; ignored once a key ring
# file exists at KEY_RING_PATH. Leave unset to have one generated for you.
# SIGNING_KEY=

# Postgres connection string. Leave unset to use the in-memory store
# (fine for local development). Migrations apply automatically on boot.
# DATABASE_URL=postgres://user:password@localhost:5432/mcp_identity

# How often the expired-row prune sweep runs, in milliseconds.
PRUNE_INTERVAL_MS=60000

# --- Delegation --------------------------------------------------------------

# Maximum delegation chain depth.
MAX_DELEGATION_DEPTH=5

# --- Refresh tokens ------------------------------------------------------------

# Refresh-token lifetime, in seconds. Default: 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000

# One-time grace window (seconds) for redeeming a just-rotated refresh
# token, tolerating a legitimate client's double-submit/retry. 0 disables
# the grace window (strict single-use).
REFRESH_REUSE_GRACE_SECONDS=10

# --- Key rotation --------------------------------------------------------------

# Filesystem path the signing key ring is persisted to/loaded from. Holds
# private key material, keep it out of version control (see .gitignore).
KEY_RING_PATH=.data/keys.json

# --- Rate limiting ---------------------------------------------------------------

# Max requests per window, per endpoint. Counted per authenticated client, or per
# remote address for unauthenticated requests and /authorize.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging -----------------------------------------------------------------

# Minimum level the structured logger writes: debug | info | warn | error
LOG_LEVEL=info

# --- Demo client ---------------------------------------------------------------
# One pre-registered confidential client. Other clients can use Client ID
# Metadata Documents instead.

CLIENT_ID=demo-agent-client

# Required outside local development: set a long random value. Unset (or the
# built-in placeholder) is accepted only when ISSUER is a loopback http URL.
# Never commit the real value.
# CLIENT_SECRET=

CLIENT_REDIRECT_URI=http://localhost:4000/callback

# The MCP server this client's tokens are bound to when /authorize gets no
# resource parameter (the RFC 8707 audience).
CLIENT_AUDIENCE=http://localhost:8000/mcp
